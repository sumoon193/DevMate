# DevMate 本地开发配置。
# 复制为 .env 后再按本机情况修改；不要把真实密钥提交到仓库。

ENVIRONMENT=dev
APP_MODE=fallback
# demo：前端验收使用的确定性链路；langgraph：启用真实 Agent Graph 编排。
AGENT_RUN_ENGINE=demo
# 审批模式：manual 全部人工（默认）；policy 写入型自动批准、管理级人工（推荐无人值守）；
# auto 写入型自动，管理级是否自动由 APPROVAL_AUTO_ALLOW_ADMIN 决定（沙箱用）。
# 全程自动化时设置 APPROVAL_MODE=policy。
APPROVAL_MODE=manual
APPROVAL_AUTO_ALLOW_ADMIN=false
# fallback 本地对象存储目录；默认避开历史 storage/ ACL 差异。
LOCAL_STORAGE_DIR=runtime_storage

# PostgreSQL
POSTGRES_DB=enterprisemind
POSTGRES_USER=enterprisemind
POSTGRES_PASSWORD=change_me_local
POSTGRES_URL=postgresql://enterprisemind:change_me_local@localhost:5432/enterprisemind

# LangGraph checkpoint：memory 适合 fallback/测试；postgres 用于跨进程审批恢复。
GRAPH_CHECKPOINTER_BACKEND=memory
# 留空时复用 POSTGRES_URL；也可为 checkpoint 单独配置 psycopg 连接串。
GRAPH_CHECKPOINTER_POSTGRES_URL=

# Redis
REDIS_URL=redis://localhost:6379/0

# Milvus
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Elasticsearch
ES_URL=http://localhost:9201

# MinIO
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=enterprisemind-docs
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Ingestion / Celery
# sync：上传接口内同步完成入库；celery：上传后返回 queued，由 worker 异步执行。
INGESTION_EXECUTION_MODE=sync
# celery + 独立 worker 时建议改为 redis，便于 API 与 worker 共享任务状态。
INGESTION_TASK_STORE=memory
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# Qwen / DashScope
# 真实 API Key 只写入本地 .env，不要提交到仓库。
# 北京地域默认使用 dashscope.aliyuncs.com；新加坡可改为 dashscope-intl.aliyuncs.com。
QWEN_API_KEY=
QWEN_CHAT_MODEL=qwen-plus
QWEN_EMBEDDING_MODEL=text-embedding-v4
QWEN_RERANK_MODEL=qwen3-rerank
QWEN_API_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_RERANK_BASE_URL=https://dashscope.aliyuncs.com/compatible-api/v1
QWEN_TIMEOUT_SECONDS=30
RAGAS_TIMEOUT_SECONDS=300
RAGAS_LANGUAGE=chinese
EMBEDDING_DIM=1024
EMBEDDING_BATCH_SIZE=10

# Phoenix / OpenTelemetry 后续接入
PHOENIX_ENDPOINT=http://localhost:6006

# Health 探测超时
HEALTH_PROBE_TIMEOUT_SECONDS=0.8

# Keycloak OIDC。full 模式必须配置，管理密码只在本机提供。
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=
OIDC_ISSUER_URL=http://localhost:8180/realms/devmate
OIDC_JWKS_URL=http://localhost:8180/realms/devmate/protocol/openid-connect/certs
OIDC_AUDIENCE=devmate-web
